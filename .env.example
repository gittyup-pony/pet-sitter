# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: API Key for Google Maps JavaScript SDK, Places API, and Routes API.
# Used for interactive maps, location autocomplete, and live GPS pet walk tracking.
# On Vercel, you can name this GOOGLE_MAPS_PLATFORM_KEY or VITE_GOOGLE_MAPS_PLATFORM_KEY.
GOOGLE_MAPS_PLATFORM_KEY=""
VITE_GOOGLE_MAPS_PLATFORM_KEY=""

# GOOGLE_CALENDAR_API_KEY / GOOGLE_CLIENT_ID: Config for Google Calendar SDK API.
# Used for syncing pet sitting schedules, walk appointments, and vet reminders to Google Calendar.
# On Vercel, you can name these with or without the VITE_ prefix.
GOOGLE_CALENDAR_API_KEY=""
VITE_GOOGLE_CALENDAR_API_KEY=""
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""
